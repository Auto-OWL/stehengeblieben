{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Dealer-Token" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 8 */3 * *" },
    { "path": "/api/csv-url-sync", "schedule": "0 */6 * * *" }
  ]
}
